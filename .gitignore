__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
.vscode/
.idea/

# 논문 PDF는 입력 파일이다. 저장소에 넣지 않는다(크고, 저작권이 논문 저자에게 있다)
*.pdf

# QA 캡처: qa_render.py가 매번 다시 만든다
work/*/qa/

# 로컬 전용 설정
.claude/settings.local.json

# 논문 원문에서 뽑은 텍스트와 그것을 그대로 담은 위임 지시문
work/*/source/
work/*/brief*.md
work/*/review/*.log
work/*/*.log
# 검토자에게 넘긴 사본(논문 텍스트, 캡처, 규칙 사본)과 실행 로그
work/*/review/ref*/
work/*/review/kref/
work/*/review/vis*/
work/*/review/*.err
work/*/review/*.png
work/*/review/pages/
work/*/review/_prompt.md
work/*/review/deck_before_korean.json

# 빌드 산출물: build_deck.py가 deck/을 매번 다시 만든다(엔진·글꼴·로고 사본, index.html).
# 저장소에는 입력(deck.json, deck/assets/fig/), 수식 캐시(deck/assets/math/: TeX 없이도 같은 결과로
# 다시 빌드된다)와 최종본 <slug>.html만 둔다
work/*/deck/*
!work/*/deck/assets/
work/*/deck/assets/*
!work/*/deck/assets/fig/
!work/*/deck/assets/math/
work/*/review/crops/
